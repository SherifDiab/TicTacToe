# Godot 4+ specific ignores
.godot/

# Godot-specific ignores
*.import
export.cfg
export_credentials.cfg

# Imported translations (automatically generated from source)
*.translation

# Mono-specific ignores
.mono/
data_*/

# Android build files
android/build/.gradle/
android/build/build/
android/build/libs/
android/build/assets/
android/build/gradle/
android/build/gradlew
android/build/gradlew.bat
android/build/gradle.properties
android/build/local.properties
android/build/*.iml
*.apk
*.aab

# iOS build files
*.ipa
*.xcodeproj/
*.xcworkspace/

# User-specific files
*.cfg.bak

# Editor backup files
*~
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/

# Export templates
export_templates/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Release builds
/build/
dist/
releases/

# Keep Android manifest template
!android/build/AndroidManifest.xml.template

# Keystore files (keep secure, don't commit!)
*.keystore
*.jks
